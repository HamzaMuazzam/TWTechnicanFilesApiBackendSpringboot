# Copy to .env next to docker-compose.yml. install.sh creates .env with a random JWT_SECRET if missing.
POSTGRES_DB=tw_notification
POSTGRES_USER=tw
POSTGRES_PASSWORD=change-me-db-password
# Port on this machine for pgAdmin/psql (container always uses 5432 internally)
POSTGRES_HOST_PORT=6033
# Optional dedicated application role (defaults to the superuser above). db-init creates/syncs it on every start.
#APP_DB_USER=tw_app
#APP_DB_PASSWORD=change-me-app-password
# false = everything open (no API key, no JWT). Turn on before going public.
AUTH_ENABLED=false
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
FIREBASE_ENABLED=false
AUTH_DEV_LOGIN_ENABLED=false
ADMIN_INITIAL_PASSWORD=ChangeMe123!
INGEST_INITIAL_API_KEY=
APP_TIMEZONE=Asia/Karachi
CORS_ALLOWED_ORIGINS=*

 # Server where Docker containers have no internet (FCM "Connection refused" but curl works on host):
# uncomment to run the API on the host network instead of Docker's bridge.
#COMPOSE_FILE=docker-compose.yml:docker-compose.host.yml
